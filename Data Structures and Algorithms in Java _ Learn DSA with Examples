@charset "utf-8";

.page-preview { max-width: 1250px; margin: 60px auto; padding: 0px 20px; color: rgb(51, 51, 51); }

.page-preview h1 { font-size: 22px; }

.page-preview p { color: rgb(102, 102, 102); font-size: 14px; }

.festival-alert-bar { position: relative; z-index: 9999; overflow: hidden; background: linear-gradient(90deg, rgb(110, 0, 0) 0%, rgb(161, 0, 0) 50%, rgb(110, 0, 0) 100%); color: rgb(255, 255, 255); font-family: Arial, sans-serif; box-shadow: rgba(0, 0, 0, 0.22) 0px 4px 16px; animation: 0.5s ease 0s 1 normal none running fabSlideDown; }

@keyframes fabSlideDown { 
  0% { transform: translateY(-100%); }
  100% { transform: translateY(0px); }
}

.festival-alert-bar::before { content: ""; position: absolute; top: 0px; left: -120%; width: 55%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent); transform: skewX(-20deg); animation: 6s ease-in-out 0s infinite normal none running fabShine; }

@keyframes fabShine { 
  0% { left: -120%; }
  35%, 100% { left: 140%; }
}

.festival-alert-content { position: relative; max-width: 1250px; min-height: 50px; margin: auto; padding: 9px 52px 9px 20px; display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; text-align: center; }

.fab-badge { display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px 5px 10px; background: rgb(255, 224, 130); color: rgb(110, 0, 0); border-radius: 20px; font-weight: 800; font-size: 13px; letter-spacing: 0.2px; box-shadow: rgba(0, 0, 0, 0.18) 0px 2px 6px; }

.fab-badge .fab-off-num { font-size: 15px; animation: 1.8s ease-in-out 0s infinite normal none running fabPulse; }

@keyframes fabPulse { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.festival-text { font-size: 14.5px; font-weight: 500; color: rgb(255, 255, 255); }

.festival-text strong { color: rgb(255, 224, 130); font-weight: 700; }

.festival-title, .festival-subtitle { display: inline; }

.festival-coupon { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; background: rgba(255, 255, 255, 0.1); border: 1px dashed rgba(255, 224, 130, 0.85); border-radius: 6px; font-size: 13px; color: rgb(255, 255, 255); }

.festival-coupon span.fab-label { opacity: 0.85; }

.festival-coupon strong { color: rgb(255, 224, 130); font-size: 14px; letter-spacing: 0.6px; }

.festival-courses-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: rgb(255, 224, 130); color: rgb(110, 0, 0); border: 0px; border-radius: 6px; font-size: 13.5px; font-weight: 800; text-decoration: none; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px; transition: 0.2s; white-space: nowrap; }

.festival-courses-btn svg { width: 14px; height: 14px; transition: transform 0.2s; }

.festival-courses-btn:hover { background: rgb(255, 255, 255); color: rgb(110, 0, 0); transform: translateY(-1px); text-decoration: none; box-shadow: rgba(0, 0, 0, 0.25) 0px 5px 12px; }

.festival-courses-btn:hover svg { transform: translateX(3px); }

.festival-close { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border: 0px; border-radius: 50%; background: rgba(255, 255, 255, 0.12); color: rgb(255, 255, 255); font-size: 18px; line-height: 1; cursor: pointer; transition: 0.2s; }

.festival-close:hover { background: rgba(255, 255, 255, 0.24); transform: translateY(-50%) rotate(90deg); }

@media (max-width: 768px) {
  .festival-alert-content { gap: 8px; padding: 9px 40px 9px 12px; }
  .fab-badge { font-size: 12px; padding: 4px 10px; }
  .fab-badge .fab-off-num { font-size: 13px; }
  .festival-text { font-size: 12.5px; width: 100%; order: 3; }
  .festival-title, .festival-subtitle { display: block; }
  .festival-subtitle { margin-top: 2px; }
  .festival-coupon { font-size: 11.5px; padding: 5px 9px; }
  .festival-coupon strong { font-size: 12.5px; }
  .festival-courses-btn { padding: 7px 12px; font-size: 12px; }
}

@media (max-width: 480px) {
  .festival-alert-content { padding-top: 10px; padding-bottom: 10px; }
  .festival-coupon { order: 4; }
  .festival-courses-btn { order: 5; }
}
