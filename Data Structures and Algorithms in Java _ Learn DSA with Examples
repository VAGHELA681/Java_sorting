@charset "utf-8";

:root { --white-color: #ffffff; --black-color: #000000; }

body { font-family: Poppins, sans-serif; font-size: 14px; color: rgb(89, 89, 89); line-height: 1.6; }

code { background: rgb(240, 240, 240); padding: 3px; border-radius: 4px; }

.dark_code { background: rgb(42, 39, 39); color: rgb(163, 159, 159); padding: 3px; border-radius: 4px; }

h2 { color: rgb(24, 24, 24); }

h3 { color: rgb(44, 44, 44); }

h4 { color: rgb(44, 44, 44); }

h5 { font-size: 1.1rem; color: rgb(65, 65, 65); }

h6 { font-size: 0.9rem; color: rgb(0, 86, 179); }

.restrict-body-content { user-select: none; }

.gray-primary { color: rgb(24, 24, 24); }

.gray-secondary { color: rgb(44, 44, 44); }

.gray-tertiary { color: rgb(65, 65, 65); }

.gray-light { color: rgb(89, 89, 89); }

.blue-primary { color: rgb(0, 86, 179); }

.font-size-xxxl { font-size: 1.8rem; }

.font-size-xxl { font-size: 1.4rem; }

.font-size-xl { font-size: 1.1rem; }

.font-size-lg { font-size: 1rem; }

.font-size-md { font-size: 0.9rem; }

.font-size-sm { font-size: 0.8rem; }

.font-size-xs { font-size: 0.6rem; }

.font-size-xxs { font-size: 10px; }

.top-bar { background-color: rgb(34, 38, 43); color: white; padding: 10px 0px; }

.top-bar a { color: white; text-decoration: none; font-size: 13px; }

.top-bar a:hover i { transition: color 0.3s; color: rgb(255, 225, 0); }

.navbar-custom { background-color: rgb(23, 26, 29) !important; }

.navbar-nav .nav-item .nav-link { color: white; font-size: 14px; font-weight: 200; margin-right: 20px; }

.navbar-nav .dropdown-menu { background-color: white; display: none; }

.navbar-nav .dropdown-menu a { color: rgb(0, 0, 0); font-size: 14px; font-weight: 200; }

.navbar-nav .nav-item:hover .dropdown-menu { display: block; }

.navbar-nav .dropdown-menu { position: absolute; top: 100%; left: 0px; margin-top: 0px; }

.navbar-toggler { border-color: rgba(255, 255, 255, 0.5); }

.navbar-toggler-icon { background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3E%3Cpath stroke='rgba(255, 255, 255, 1)' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3E%3C/svg%3E"); }

.banner { position: relative; background-image: url("https://smartprogramming.in/assets/images/others/banner-bg.jpg"); background-size: cover; background-position: center center; height: 600px; color: white; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; }

.banner::before { content: ""; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 1; }

.banner .container { position: relative; z-index: 2; }

.banner h1 { font-size: 3rem; text-shadow: rgba(0, 0, 0, 0.7) 2px 2px 4px; }

.banner-changing-title { font-size: 2.5rem; color: rgb(255, 242, 0); }

.ipb-card-section { margin-top: -80px; }

.card { z-index: 1; position: relative; margin: 20px; }

